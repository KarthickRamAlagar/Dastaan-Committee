# ============================================================
#  Dastaan settings.  `npm run setup` copies this to .env
#  .env is never committed. Fill in the values below once.
#  All three APIs read this one file. In production use `npm run secrets`.
# ============================================================

# --- Local development only. In production these come from each api/wrangler.json ---
ENVIRONMENT=development
OTHERS_ORIGIN=http://localhost:3000
CONVENOR_ORIGIN=http://localhost:3001
ADMIN_ORIGIN=http://localhost:3002

# --- Admin account -----------------------------------------
# Comma separated. These people sign in with the password below.
ADMIN_EMAILS=karthifde@gmail.com
# At least 12 characters
ADMIN_PASSWORD=change-me-to-a-long-password
# At least 32 characters. Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-change-me-change-me-change-me-0123456789

# --- Sign-in codes (OTP) -----------------------------------
# true  = everyone except the Admin must enter the 6 digit code that is emailed. Use this for real use.
# false = TESTING ONLY. Anyone with a registered email signs in without a code.
LOGIN_OTP=true
# Only college emails (bl.<anything>@bl.students.amrita.edu) can sign in or be registered. ADMIN_EMAILS are exempt.
# Set false only for local testing with fake addresses such as the sample data (@dastaan.test).
COLLEGE_EMAIL_ONLY=true

# --- Email -------------------------------------------------
# smtp = send real email (needs the SMTP values below)
# log  = local only: do not send, print the email in the terminal and keep it at /api/dev/outbox
# off  = send nothing
# Leave empty to choose automatically: smtp when SMTP_HOST is filled, otherwise log (local) or off (production).
EMAIL_MODE=log

SMTP_HOST=
SMTP_PORT=587
# Port 587: SMTP_SECURE=false and SMTP_START_TLS=true.   Port 465: SMTP_SECURE=true and SMTP_START_TLS=false.
SMTP_SECURE=false
SMTP_START_TLS=true
SMTP_USER=
SMTP_PASS=
# The address people see the email coming from. Most providers need this to be a verified sender.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Dastaan
# Logos in emails load from this public address (it must serve /brand/dastaan-logo.png and /brand/amrita-logo.png).
# Leave empty in production (the app's own address is used). Locally, mail apps cannot reach localhost, so logos stay hidden unless you set a public address.
MAIL_ASSET_URL=
