{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "skipLibCheck": true, "noEmit": true, "isolatedModules": true, "resolveJsonModule": true
  },
  "include": ["src", "test"]
}
