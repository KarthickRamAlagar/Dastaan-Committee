{
  "name": "@dastaan/others-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/sync-assets.mjs others && next dev --turbopack -p 3000",
    "build": "node ../../scripts/sync-assets.mjs others && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "cf:build": "node ../../scripts/sync-assets.mjs others && opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "dev:webpack": "node ../../scripts/sync-assets.mjs others && next dev -p 3000"
  },
  "dependencies": {
    "@dastaan/shared": "*",
    "@opennextjs/cloudflare": "^1.8.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "wrangler": "^4.30.0"
  }
}
