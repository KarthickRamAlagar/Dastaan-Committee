{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dastaan-others",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "committee.dastaan.example.edu/*",
      "zone_name": "example.edu"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_NAME": "Dastaan",
    "NEXT_PUBLIC_APP_TAGLINE": "Multi Fest coordination"
  }
}
