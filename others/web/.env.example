# Copy to .env.local (npm run setup does it). Used only by `next dev` and `next build`. No secrets here.

# Where Next forwards /api in development: this app's own API
API_ORIGIN=http://localhost:8787
# Development only: uploads go straight to this app's API. Leave this line out in production.
NEXT_PUBLIC_UPLOAD_ORIGIN=http://localhost:8787

# Developer tools (query inspector and the Next.js badge). Only ever shown in `next dev`, never in a production build.
# Set to true while developing, false for demos and reviews.
NEXT_PUBLIC_DEV_TOOLS=false

NEXT_PUBLIC_APP_NAME=Dastaan
NEXT_PUBLIC_APP_TAGLINE=Multi Fest coordination
NEXT_PUBLIC_SUPPORT_EMAIL=support@dastaanfest.org
NEXT_PUBLIC_FEST_URL=https://dastaanfest.org
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/your-profile

# Where each app lives. Used for the "open the right portal" link.
NEXT_PUBLIC_OTHERS_URL=http://localhost:3000
NEXT_PUBLIC_CONVENOR_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
