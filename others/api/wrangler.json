{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dastaan-others-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dastaan",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "routes": [
    {
      "pattern": "committee.dastaan.example.edu/api/*",
      "zone_name": "example.edu"
    }
  ],
  "vars": {
    "APP_NAME": "Dastaan",
    "APP_TAGLINE": "Multi Fest coordination",
    "ENVIRONMENT": "production",
    "OTHERS_ORIGIN": "https://committee.dastaan.example.edu",
    "CONVENOR_ORIGIN": "https://convenor.dastaan.example.edu",
    "ADMIN_ORIGIN": "https://admin.dastaan.example.edu"
  }
}
