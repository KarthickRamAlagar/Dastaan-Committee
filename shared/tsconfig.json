{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true, "noEmit": true, "isolatedModules": true,
    "jsx": "preserve", "esModuleInterop": true, "resolveJsonModule": true
  },
  "include": ["src", "web", "web/**/*.d.ts"]
}
